{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-page?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
